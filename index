/* =========================================================
   ENTRENO ACTIVO
   Usa timestamps reales (Date.now) en lugar de contar ticks,
   para que el cronómetro NO se pare al bloquear pantalla o
   cambiar de app. Cuando la app vuelve al primer plano,
   recalcula dónde debería estar y avanza fases si es necesario.
========================================================= */
let W = null; // sesión activa
let timerId = null;
let wakeLock = null;
let silentAudio = null; // mantiene audio activo en segundo plano

const phaseLabels = {
  warmup:   { label:'Calentamiento', instr:'Camina a paso ligero', voice:'Empezamos con cinco minutos caminando a paso ligero' },
  walk:     { label:'Caminar',       instr:'Recupera andando',     voice:'Ahora caminando' },
  run:      { label:'Correr',        instr:'Carrera suave',        voice:'Ahora a correr, suave' },
  cooldown: { label:'Vuelta a la calma', instr:'Camina relajado',  voice:'Muy bien. Cinco minutos de vuelta a la calma, caminando' },
};

/* Mantiene la pestaña "viva" reproduciendo audio silencioso en
   bucle — truco estándar que usan apps web de fitness/navegación.
   En iOS en particular esto evita que Safari suspenda la pestaña. */
function startSilentKeepalive(){
  try{
    const ctx = getAudioCtx();
    if(!ctx) return;
    if(silentAudio) return;
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.frequency.value = 1;  // 1 Hz, inaudible
    g.gain.value = 0.0001;    // casi 0
    osc.connect(g).connect(ctx.destination);
    osc.start();
    silentAudio = { osc, g };
  }catch(e){}
}
function stopSilentKeepalive(){
  if(silentAudio){
    try{ silentAudio.osc.stop(); silentAudio.osc.disconnect(); silentAudio.g.disconnect(); }catch(e){}
    silentAudio = null;
  }
}

function startWorkout(){
  const idx = weekIdx();
  if(idx === PLAN.length-1 && S.sessionsInWeek>=3) return;
  const segments = buildSession(idx);
  const now = Date.now();
  W = {
    weekIdx: idx,
    segments,
    currentSeg: 0,
    segStartTs: now,        // timestamp real de inicio de la fase actual
    pausedAt: null,          // si está pausado, timestamp de cuándo
    pauseAccum: 0,           // ms totales en pausa dentro de la fase actual
    totalStart: now,         // inicio de toda la sesión
    totalPauseAccum: 0,      // ms totales en pausa de toda la sesión
    totalTarget: totalTime(segments),
    segmentsDone: [],        // duraciones reales completadas (seg) para stats
    warned: false,
    paused: false,
    // GPS
    gpsActive: !!S.settings.gps,
    gpsWatchId: null,
    lastPos: null,
    distanceM: 0,
    gpsPoints: 0,
    gpsTrack: [],        // array de [lat, lon] para dibujar la ruta
    map: null,
    mapLine: null,
    mapMarker: null,
  };
  document.getElementById('workout').classList.add('active');
  document.getElementById('w-week').textContent =
    `Semana ${idx+1} · Sesión ${S.sessionsInWeek+1}`;
  document.getElementById('w-totalmax').textContent = fmtTime(W.totalTarget);
  document.getElementById('w-total-idx').textContent = segments.length;

  // Mostrar u ocultar bloque GPS
  document.getElementById('w-gps').style.display = W.gpsActive ? 'grid' : 'none';
  document.getElementById('w-map-wrap').style.display = W.gpsActive ? 'block' : 'none';

  // Mecanismos anti-suspensión
  requestWakeLock();
  startSilentKeepalive();

  // GPS si activado
  if(W.gpsActive){
    startGPS();
    initMiniMap();
  }

  // Anunciar primera fase
  announcePhase(0, true);
  updateWorkoutUI();

  // Tick rápido para UI fluida; el tiempo real sale siempre de Date.now()
  timerId = setInterval(tick, 500);
}

async function requestWakeLock(){
  try{
    if('wakeLock' in navigator){
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', ()=>{ wakeLock = null; });
    }
  }catch(e){}
}
function releaseWakeLock(){
  try{ if(wakeLock){ wakeLock.release(); wakeLock=null; } }catch(e){}
}

/* Devuelve segundos transcurridos en la fase actual (descontando pausas) */
function segElapsedSec(){
  if(!W) return 0;
  const now = W.paused ? W.pausedAt : Date.now();
  const ms = now - W.segStartTs - W.pauseAccum;
  return Math.max(0, Math.floor(ms/1000));
}
/* Segundos totales transcurridos en la sesión (descontando pausas) */
function totalElapsedSec(){
  if(!W) return 0;
  const now = W.paused ? W.pausedAt : Date.now();
  const ms = now - W.totalStart - W.totalPauseAccum;
  return Math.max(0, Math.floor(ms/1000));
}

function tick(){
  if(!W || W.paused) return;

  // ¿Ha vencido la fase actual? Puede haber vencido varias si estuvo dormido.
  let safety = 0;
  while(W && !W.paused && segElapsedSec() >= W.segments[W.currentSeg].t && safety < 50){
    const seg = W.segments[W.currentSeg];
    // Guardar duración real de esa fase (para stats)
    W.segmentsDone.push({ p: seg.p, t: seg.t });
    // Avanzar fase manteniendo sincronía con reloj real
    const segEndTs = W.segStartTs + (seg.t * 1000) + W.pauseAccum;
    W.currentSeg++;
    if(W.currentSeg >= W.segments.length){
      // Sesión terminada
      endWorkout(false);
      return;
    }
    // La nueva fase empieza cuando la anterior debería haber terminado
    W.segStartTs = segEndTs;
    W.pauseAccum = 0;
    W.warned = false;
    announcePhase(W.currentSeg, false);
    safety++;
  }

  if(!W) return;

  // Aviso 10s antes del cambio
  const seg = W.segments[W.currentSeg];
  const remaining = seg.t - segElapsedSec();
  if(S.settings.warn && !W.warned && remaining === 10 && W.currentSeg < W.segments.length-1){
    const next = W.segments[W.currentSeg+1];
    if(next.p === 'run'){ notifyPre('Prepárate. En diez segundos, a correr.'); }
    else if(next.p === 'walk'){ notifyPre('Muy bien. En diez segundos, a caminar.'); }
    else if(next.p === 'cooldown'){ notifyPre('Último tramo. En diez segundos, vuelta a la calma.'); }
    W.warned = true;
  }

  updateWorkoutUI();
}

function updateWorkoutUI(){
  if(!W) return;
  const seg = W.segments[W.currentSeg];
  const lbl = phaseLabels[seg.p];
  const phaseEl = document.getElementById('w-phase');
  phaseEl.textContent = lbl.label;
  phaseEl.className = 'w-phase '+seg.p;
  document.getElementById('w-instruction').textContent = lbl.instr;
  document.getElementById('w-ring').className = 'w-ring '+seg.p;

  const remaining = seg.t - segElapsedSec();
  document.getElementById('w-time').textContent = fmtTime(Math.max(0,remaining));
  document.getElementById('w-seglabel').textContent = lbl.label;
  document.getElementById('w-total').textContent = fmtTime(totalElapsedSec());
  document.getElementById('w-idx').textContent = W.currentSeg+1;

  // Círculo de progreso
  const ringLen = 2*Math.PI*90;
  const pct = Math.min(1, segElapsedSec() / seg.t);
  document.getElementById('ring-prog').setAttribute('stroke-dashoffset', ringLen*(1-pct));

  // Barra total
  document.getElementById('w-progbar').style.width = Math.min(100,(totalElapsedSec()/W.totalTarget*100))+'%';

  // GPS
  if(W.gpsActive){
    const km = W.distanceM / 1000;
    document.getElementById('w-km').textContent = km.toFixed(2);
    // Ritmo medio min/km sobre el tiempo total de la sesión
    const tot = totalElapsedSec();
    if(km > 0.05 && tot > 0){
      const pace = (tot/60) / km; // min/km
      const pMin = Math.floor(pace);
      const pSec = Math.round((pace - pMin)*60);
      document.getElementById('w-pace').textContent = pMin+':'+String(pSec).padStart(2,'0');
    } else {
      document.getElementById('w-pace').textContent = '—';
    }
  }
}

function togglePause(){
  if(!W) return;
  if(!W.paused){
    W.paused = true;
    W.pausedAt = Date.now();
  } else {
    const pauseDuration = Date.now() - W.pausedAt;
    W.pauseAccum += pauseDuration;
    W.totalPauseAccum += pauseDuration;
    W.pausedAt = null;
    W.paused = false;
  }
  document.getElementById('w-pause').textContent = W.paused ? 'Reanudar' : 'Pausar';
  const mode = S.settings.mode || 'voice';
  if(mode === 'beep'){
    beep(W.paused ? 440 : 660, 150, 0.4);
  } else {
    if(W.paused) speakVoice('Pausado');
    else speakVoice('Continuamos');
  }
}

function skipPhase(){
  if(!W) return;
  if(!confirm('¿Saltar a la siguiente fase?')) return;
  const seg = W.segments[W.currentSeg];
  W.segmentsDone.push({ p: seg.p, t: segElapsedSec() });
  W.currentSeg++;
  W.segStartTs = Date.now();
  W.pauseAccum = 0;
  W.warned = false;
  if(W.currentSeg >= W.segments.length){
    endWorkout(false);
    return;
  }
  announcePhase(W.currentSeg, false);
  updateWorkoutUI();
}

function confirmStop(){
  if(!W) return;
  if(totalElapsedSec() < 30){
    endWorkout(true);
    return;
  }
  document.getElementById('modal-stop').classList.add('active');
}

function endWorkout(partial){
  if(!W) return;
  closeModal('modal-stop');
  clearInterval(timerId);
  timerId = null;
  releaseWakeLock();
  stopSilentKeepalive();
  stopGPS();
  destroyMiniMap();
  try{ speechSynthesis.cancel(); }catch(e){}
  stopDuck();

  const completedFull = W.currentSeg >= W.segments.length;
  const totalElapsed = totalElapsedSec();
  const didMoreThanHalf = totalElapsed >= W.totalTarget * 0.5;
  const save = completedFull || didMoreThanHalf;

  // Calcular tiempo corrido real a partir de segmentsDone + fase actual en curso
  let runSec = 0;
  W.segmentsDone.forEach(s=>{ if(s.p==='run') runSec += s.t; });
  if(!completedFull && W.currentSeg < W.segments.length && W.segments[W.currentSeg].p==='run'){
    runSec += segElapsedSec();
  }

  if(save){
    // Simplificar track: si hay >200 puntos, decimar por media
    let track = W.gpsTrack.length > 0 ? W.gpsTrack.slice() : null;
    if(track && track.length > 200){
      const step = Math.ceil(track.length / 200);
      const decimated = [];
      for(let i=0; i<track.length; i+=step){ decimated.push(track[i]); }
      // Añadir siempre el último punto
      if(decimated[decimated.length-1] !== track[track.length-1]){
        decimated.push(track[track.length-1]);
      }
      track = decimated;
    }
    // Redondear a 6 decimales (~10cm, más que suficiente) para ahorrar espacio
    if(track){
      track = track.map(([lat,lon])=>[Math.round(lat*1e6)/1e6, Math.round(lon*1e6)/1e6]);
    }
    S.sessions.push({
      date: new Date().toISOString(),
      week: W.weekIdx+1,
      session: S.sessionsInWeek+1,
      totalSec: totalElapsed,
      runSec,
      distanceM: Math.round(W.distanceM),
      track,
      completed: completedFull
    });
    if(completedFull){
      S.sessionsInWeek++;
      if(S.sessionsInWeek >= 3 && S.currentWeek < PLAN.length-1){
        S.currentWeek++;
        S.sessionsInWeek = 0;
      } else if(S.sessionsInWeek > 3){
        S.sessionsInWeek = 3;
      }
    }
    saveState();
  }

  // Modal de fin
  if(completedFull){
    const mode = S.settings.mode || 'voice';
    if(mode === 'beep'){ beepPattern('done'); }
    else if(mode === 'both'){ beepPattern('done'); setTimeout(()=>speakVoice('¡Enhorabuena! Sesión completada.'), 800); }
    else { speakVoice('¡Enhorabuena! Sesión completada.'); }
    vibrate([200,100,200,100,400]);
    document.getElementById('m-title').textContent = '¡Sesión completada!';
    document.getElementById('m-subtitle').textContent = '¡Bien hecho! Has terminado la sesión entera.';
  } else if(save){
    document.getElementById('m-title').textContent = 'Sesión parcial guardada';
    document.getElementById('m-subtitle').textContent = 'No has terminado, pero se guarda igual en tu progreso.';
  } else {
    document.getElementById('m-title').textContent = 'Sesión no guardada';
    document.getElementById('m-subtitle').textContent = 'Llevabas muy poco tiempo, no se registra.';
  }
  document.getElementById('m-time').textContent = fmtTime(totalElapsed);
  document.getElementById('m-run').textContent = fmtTime(runSec);
  // Mostrar distancia en el modal si había GPS
  const mKm = document.getElementById('m-km-row');
  if(W.gpsActive && W.distanceM > 0){
    mKm.style.display = '';
    document.getElementById('m-km').textContent = (W.distanceM/1000).toFixed(2)+' km';
  } else {
    mKm.style.display = 'none';
  }

  document.getElementById('workout').classList.remove('active');
  document.getElementById('w-pause').textContent = 'Pausar';
  document.getElementById('modal-finish').classList.add('active');
  W = null;
  renderAll();
}

/* =========================================================
   GPS - seguimiento de distancia
========================================================= */
function startGPS(){
  if(!('geolocation' in navigator)) return;
  if(!W || W.gpsWatchId !== null) return;
  try{
    W.gpsWatchId = navigator.geolocation.watchPosition(
      (pos)=>{
        if(!W) return;
        const { latitude:lat, longitude:lon, accuracy } = pos.coords;
        // Descartar posiciones con mala precisión (>50m)
        if(accuracy > 50) return;
        if(W.lastPos){
          const d = haversine(W.lastPos.lat, W.lastPos.lon, lat, lon);
          const dt = (Date.now() - W.lastPos.ts)/1000;
          const speed = dt>0 ? d/dt : 0;
          if(speed < 8){ // filtro de saltos imposibles
            if(!W.paused) W.distanceM += d;
          }
        }
        W.lastPos = { lat, lon, ts: Date.now() };
        W.gpsPoints++;
        // Añadir al track y actualizar mapa
        W.gpsTrack.push([lat, lon]);
        updateMiniMap();
      },
      (err)=>{ console.warn('GPS err', err); },
      { enableHighAccuracy:true, maximumAge:2000, timeout:15000 }
    );
  }catch(e){ console.warn(e); }
}
function stopGPS(){
  if(W && W.gpsWatchId !== null){
    try{ navigator.geolocation.clearWatch(W.gpsWatchId); }catch(e){}
    W.gpsWatchId = null;
  }
}
/* Fórmula Haversine: distancia entre dos coordenadas en metros */
function haversine(lat1, lon1, lat2, lon2){
  const R = 6371000;
  const toRad = x => x*Math.PI/180;
  const dLat = toRad(lat2-lat1);
  const dLon = toRad(lon2-lon1);
  const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)**2;
  return 2*R*Math.asin(Math.sqrt(a));
}

/* =========================================================
   MAPA DE RUTA (Leaflet)
========================================================= */
function initMiniMap(){
  if(typeof L === 'undefined') return;
  if(!W) return;
  try{
    const el = document.getElementById('w-map');
    el.innerHTML = '';
    const map = L.map(el, {
      zoomControl:false,
      attributionControl:true,
      dragging:true,
      scrollWheelZoom:false,
      doubleClickZoom:false,
      boxZoom:false,
      tap:true,
    }).setView([39.5696, 2.6502], 14); // Mallorca por defecto hasta que llegue la 1ª posición
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:'© OSM',
      maxZoom:19,
    }).addTo(map);
    W.map = map;
    W.mapLine = L.polyline([], { color:'#b96e4e', weight:4, opacity:.85 }).addTo(map);
    // Refresco tras abrir para que Leaflet recalcule tamaño
    setTimeout(()=>{ try{ map.invalidateSize(); }catch(e){} }, 300);
  }catch(e){ console.warn(e); }
}
function updateMiniMap(){
  if(!W || !W.map || !W.mapLine) return;
  const track = W.gpsTrack;
  if(track.length === 0) return;
  W.mapLine.setLatLngs(track);
  const last = track[track.length-1];
  // Marcador de posición actual
  if(!W.mapMarker){
    W.mapMarker = L.circleMarker(last, {
      radius:7, color:'#faf6ec', weight:2,
      fillColor:'#b96e4e', fillOpacity:1
    }).addTo(W.map);
  } else {
    W.mapMarker.setLatLng(last);
  }
  // Auto-seguir al corredor: centra en la posición actual sin hacer zoom excesivo
  if(track.length === 1){
    W.map.setView(last, 17);
  } else if(track.length % 5 === 0){
    // Cada 5 puntos, reajusta ligeramente para que quede centrado
    W.map.panTo(last, { animate:true, duration:0.5 });
  }
}
function destroyMiniMap(){
  if(W && W.map){
    try{ W.map.remove(); }catch(e){}
    W.map = null; W.mapLine = null; W.mapMarker = null;
  }
}

/* Mapa del historial - modal de ruta */
let routeMapInstance = null;
function openRouteModal(sessionIndex){
  const s = S.sessions[sessionIndex];
  if(!s) return;
  if(!s.track || s.track.length < 2){
    alert('Esta sesión no tiene datos de ruta guardados.');
    return;
  }
  const d = new Date(s.date);
  const day = d.getDate();
  const mo = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'][d.getMonth()];
  document.getElementById('mr-title').textContent = `Semana ${s.week} · Sesión ${s.session}`;
  document.getElementById('mr-subtitle').textContent = `${day} de ${mo} · ${PLAN[s.week-1]?.sub || ''}`;
  document.getElementById('mr-time').textContent = fmtTime(s.totalSec);
  document.getElementById('mr-km').textContent = ((s.distanceM||0)/1000).toFixed(2)+' km';
  document.getElementById('modal-route').classList.add('active');

  // Crear mapa (esperar a que el modal sea visible)
  setTimeout(()=>{
    try{
      if(routeMapInstance){ routeMapInstance.remove(); routeMapInstance = null; }
      const el = document.getElementById('mr-map');
      el.innerHTML = '';
      routeMapInstance = L.map(el, {
        zoomControl:true, scrollWheelZoom:true,
      });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution:'© OpenStreetMap', maxZoom:19,
      }).addTo(routeMapInstance);
      const line = L.polyline(s.track, { color:'#b96e4e', weight:4, opacity:.9 }).addTo(routeMapInstance);
      // Marcadores de inicio y fin
      L.circleMarker(s.track[0], {
        radius:8, color:'#faf6ec', weight:2,
        fillColor:'#7a9b7c', fillOpacity:1
      }).addTo(routeMapInstance).bindPopup('Inicio');
      L.circleMarker(s.track[s.track.length-1], {
        radius:8, color:'#faf6ec', weight:2,
        fillColor:'#b96e4e', fillOpacity:1
      }).addTo(routeMapInstance).bindPopup('Fin');
      routeMapInstance.fitBounds(line.getBounds(), { padding:[20,20] });
      setTimeout(()=>{ try{ routeMapInstance.invalidateSize(); }catch(e){} }, 300);
    }catch(e){ console.warn(e); }
  }, 150);
}

function announcePhase(segIdx, isFirst){
  const seg = W.segments[segIdx];
  const lbl = phaseLabels[seg.p];
  let text;
  if(isFirst){
    text = lbl.voice;
  } else {
    const mins = Math.floor(seg.t/60), secs = seg.t%60;
    let durTxt = '';
    if(mins>0 && secs===0) durTxt = mins+' minuto'+(mins>1?'s':'');
    else if(mins===0) durTxt = secs+' segundos';
    else durTxt = mins+' minuto'+(mins>1?'s':'')+' y '+secs+' segundos';

    if(seg.p === 'run') text = '¡Ahora a correr! '+durTxt+'.';
    else if(seg.p === 'walk') text = 'Caminando '+durTxt+'. Recupera.';
    else if(seg.p === 'cooldown') text = 'Vuelta a la calma. Cinco minutos caminando.';
    else text = lbl.voice;
  }
  notifyPhase(seg.p, text);
  // Vibración
  if(seg.p === 'run') vibrate([200,100,200]);
  else if(seg.p === 'walk') vibrate([200]);
  else if(seg.p === 'cooldown') vibrate([200,100,200,100,200]);
}

function closeModal(id){
  document.getElementById(id).classList.remove('active');
}

