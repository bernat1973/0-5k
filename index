<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#f5f1e8">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="mobile-web-app-capable" content="yes">
<title>5K · De cero a cinco</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,800;1,400;1,800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<style>
  :root{
    --bg:#f5f1e8;          /* crema suave */
    --bg-2:#ede7d8;        /* crema más cálida */
    --bg-3:#e2dac5;        /* crema acento */
    --ink:#2e2e2e;         /* tinta grafito */
    --ink-dim:#8a8577;     /* gris cálido */
    --accent:#b96e4e;      /* terracota suave */
    --warm:#c8a876;        /* beige dorado apagado */
    --walk:#7a9b7c;        /* verde salvia (andar) */
    --run:#b96e4e;         /* terracota (correr) */
    --warmup:#c8a876;      /* dorado apagado (calentar) */
    --ok:#6b8e6f;          /* verde salvia oscuro (ok) */
    --line:rgba(46,46,46,.08);
    --line-2:rgba(46,46,46,.14);
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none}
  html,body{height:100%;overflow-x:hidden}
  body{
    font-family:'Fraunces',Georgia,serif;
    background:var(--bg);
    color:var(--ink);
    min-height:100vh;
    padding-bottom:100px;
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(185,110,78,.08), transparent 60%),
      radial-gradient(ellipse 60% 40% at 100% 100%, rgba(122,155,124,.08), transparent 60%);
  }
  .noise{
    position:fixed;inset:0;pointer-events:none;opacity:.025;z-index:1;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* HEADER */
  header{
    padding:22px 20px 14px;
    display:flex;justify-content:space-between;align-items:flex-end;
    border-bottom:1px solid var(--line);
    position:relative;z-index:2;
  }
  .brand{display:flex;flex-direction:column;gap:2px}
  .brand .mark{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;letter-spacing:.25em;
    color:var(--ink-dim);text-transform:uppercase;
  }
  .brand h1{
    font-family:'Fraunces',serif;
    font-weight:800;font-size:26px;line-height:1;
    font-style:italic;letter-spacing:-.02em;
  }
  .brand h1 .five{color:var(--accent);font-style:normal}
  .hdr-right{
    font-family:'JetBrains Mono',monospace;
    font-size:10px;color:var(--ink-dim);text-align:right;line-height:1.6;
  }
  .hdr-right b{color:var(--ink);font-weight:600}

  /* TABS */
  nav.tabs{
    position:fixed;bottom:0;left:0;right:0;z-index:50;
    background:rgba(245,241,232,.92);backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    border-top:1px solid var(--line-2);
    display:grid;grid-template-columns:repeat(4,1fr);
    padding:10px 6px calc(10px + env(safe-area-inset-bottom));
  }
  nav.tabs button{
    background:none;border:0;color:var(--ink-dim);
    font-family:'JetBrains Mono',monospace;font-size:10px;
    letter-spacing:.15em;text-transform:uppercase;
    padding:8px 4px;cursor:pointer;
    display:flex;flex-direction:column;align-items:center;gap:5px;
    transition:color .2s;
  }
  nav.tabs button.active{color:var(--accent)}
  nav.tabs button svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.5}

  /* VIEWS */
  main{padding:20px;position:relative;z-index:2}
  .view{display:none;animation:fadein .3s ease}
  .view.active{display:block}
  @keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  /* HOY */
  .today-card{
    background:linear-gradient(155deg,#faf6ec 0%,#ede7d8 100%);
    border:1px solid var(--line-2);
    border-radius:22px;
    padding:24px 22px;
    position:relative;overflow:hidden;
    box-shadow:0 2px 16px rgba(46,46,46,.04);
  }
  .today-card::before{
    content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;
    background:radial-gradient(circle,var(--accent) 0%,transparent 70%);
    opacity:.1;pointer-events:none;
  }
  .week-tag{
    font-family:'JetBrains Mono',monospace;
    font-size:10px;letter-spacing:.25em;color:var(--warm);
    text-transform:uppercase;position:relative;
  }
  .today-card h2{
    font-size:30px;font-weight:800;line-height:1.05;margin:8px 0 4px;
    letter-spacing:-.02em;position:relative;
  }
  .today-card h2 em{color:var(--accent);font-style:italic}
  .today-card .subtitle{color:var(--ink-dim);font-size:14px;font-style:italic;margin-bottom:18px;position:relative;line-height:1.4}
  .today-stats{
    display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0 20px;
    padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
    position:relative;
  }
  .stat{text-align:center}
  .stat .val{font-size:22px;font-weight:600;color:var(--ink);display:block;line-height:1;font-family:'JetBrains Mono',monospace}
  .stat .lbl{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.18em;color:var(--ink-dim);text-transform:uppercase;margin-top:7px;display:block}

  .segments{display:flex;gap:1px;height:12px;border-radius:6px;overflow:hidden;margin-bottom:8px;position:relative}
  .seg{height:100%;transition:opacity .2s}
  .seg.warmup{background:var(--warmup)}
  .seg.walk{background:var(--walk)}
  .seg.run{background:var(--run)}
  .seg.cooldown{background:var(--warmup);opacity:.75}
  .seg-legend{display:flex;gap:14px;font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-dim);letter-spacing:.12em;text-transform:uppercase;position:relative;flex-wrap:wrap}
  .seg-legend span::before{content:'';display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px;vertical-align:middle}
  .seg-legend .l-warm::before{background:var(--warmup)}
  .seg-legend .l-walk::before{background:var(--walk)}
  .seg-legend .l-run::before{background:var(--run)}

  .start-btn{
    display:block;width:100%;margin-top:22px;
    background:var(--accent);color:#faf6ec;
    border:0;padding:18px;border-radius:14px;
    font-family:'Fraunces',serif;font-weight:800;font-size:16px;
    cursor:pointer;
    text-transform:uppercase;letter-spacing:.18em;
    transition:transform .15s;
    box-shadow:0 6px 18px rgba(185,110,78,.2);position:relative;
  }
  .start-btn:active{transform:scale(.98)}
  .start-btn.done{background:var(--ok);pointer-events:none;box-shadow:0 6px 18px rgba(107,142,111,.2)}
  .manual-btn{
    display:block;width:100%;margin-top:10px;
    background:transparent;color:var(--ink-dim);
    border:1px solid var(--line-2);padding:13px;border-radius:14px;
    font-family:'JetBrains Mono',monospace;font-size:11px;
    letter-spacing:.18em;text-transform:uppercase;cursor:pointer;
    transition:color .2s,border-color .2s;position:relative;
  }
  .manual-btn:active{background:rgba(46,46,46,.04)}
  .manual-btn.done{display:none}

  .tips{
    margin-top:22px;padding:16px 18px;
    border-left:2px solid var(--warm);
    background:rgba(244,184,96,.05);border-radius:0 10px 10px 0;
  }
  .tips h4{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.25em;color:var(--warm);text-transform:uppercase;margin-bottom:8px}
  .tips p{font-size:14px;line-height:1.55;color:var(--ink-dim)}
  .tips p em{color:var(--ink);font-style:italic}

  /* PLAN */
  .plan-header{margin-bottom:18px}
  .plan-header h2{font-size:28px;font-weight:800;font-style:italic;letter-spacing:-.02em}
  .plan-header p{color:var(--ink-dim);font-size:14px;margin-top:4px;line-height:1.5}

  .phase{margin-bottom:26px}
  .phase-title{
    font-family:'JetBrains Mono',monospace;font-size:10px;
    letter-spacing:.22em;color:var(--warm);text-transform:uppercase;
    margin-bottom:10px;display:flex;align-items:center;gap:10px;
  }
  .phase-title::after{content:'';flex:1;height:1px;background:var(--line)}

  .week-row{
    display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;
    padding:14px;border:1px solid var(--line);border-radius:12px;
    margin-bottom:8px;cursor:pointer;transition:border-color .2s,background .2s;
    background:rgba(255,255,255,.01);
  }
  .week-row:active{background:rgba(255,255,255,.03)}
  .week-row.current{border-color:var(--accent);background:rgba(255,87,51,.05)}
  .week-row.done{opacity:.5}
  .week-num{
    font-family:'JetBrains Mono',monospace;font-size:11px;
    background:var(--bg-2);padding:6px 10px;border-radius:6px;
    min-width:54px;text-align:center;letter-spacing:.08em;
  }
  .week-row.current .week-num{background:var(--accent);color:#faf6ec;font-weight:600}
  .week-desc{font-size:14px;line-height:1.35}
  .week-desc b{font-weight:600}
  .week-desc .mini{color:var(--ink-dim);font-size:11px;display:block;margin-top:3px;font-family:'JetBrains Mono',monospace;letter-spacing:.03em}
  .week-status{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-dim);letter-spacing:.08em}
  .week-status.done{color:var(--ok)}

  /* HISTORIAL */
  .stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
  .stat-card{
    background:var(--bg-2);border:1px solid var(--line);
    padding:16px;border-radius:14px;
  }
  .stat-card .big{font-size:28px;font-weight:800;font-style:italic;color:var(--ink);line-height:1;font-family:'Fraunces',serif}
  .stat-card .big.acc{color:var(--accent)}
  .stat-card .big.ok{color:var(--ok)}
  .stat-card .lbl{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.2em;color:var(--ink-dim);margin-top:7px;text-transform:uppercase}

  .chart-wrap{
    background:var(--bg-2);border:1px solid var(--line);
    padding:18px;border-radius:14px;margin-bottom:20px;
  }
  .chart-wrap h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.25em;color:var(--ink-dim);text-transform:uppercase;margin-bottom:14px}
  .chart-wrap canvas{max-height:220px}

  .sessions-title{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.25em;color:var(--ink-dim);text-transform:uppercase;margin:0 0 10px}
  .session-row{
    display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;
    padding:12px 0;border-bottom:1px solid var(--line);
  }
  .session-row.clickable{cursor:pointer;transition:background .15s;margin:0 -10px;padding:12px 10px;border-radius:8px}
  .session-row.clickable:active{background:rgba(185,110,78,.06)}
  .session-row:last-child{border-bottom:0}
  .map-badge{
    display:inline-block;margin-left:6px;
    font-family:'JetBrains Mono',monospace;font-size:9px;
    letter-spacing:.15em;text-transform:uppercase;
    color:var(--accent);padding:2px 6px;border-radius:4px;
    background:rgba(185,110,78,.1);
  }
  .manual-badge{
    display:inline-block;margin-left:6px;
    font-family:'JetBrains Mono',monospace;font-size:9px;
    letter-spacing:.15em;text-transform:uppercase;
    color:var(--ink-dim);padding:2px 6px;border-radius:4px;
    background:rgba(46,46,46,.07);
  }
  .sess-date{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-dim);min-width:60px;line-height:1.4}
  .sess-date b{display:block;color:var(--ink);font-size:13px}
  .sess-detail{font-size:14px}
  .sess-detail .mini{font-size:11px;color:var(--ink-dim);display:block;margin-top:2px;font-family:'JetBrains Mono',monospace}
  .sess-time{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--ok);font-weight:600}

  .empty{
    text-align:center;padding:50px 20px;color:var(--ink-dim);
    font-style:italic;font-size:15px;line-height:1.5;
  }

  /* AJUSTES */
  .settings-sect{margin-bottom:30px}
  .settings-sect h3{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.25em;color:var(--warm);text-transform:uppercase;margin-bottom:8px}
  .settings-row{
    display:flex;justify-content:space-between;align-items:center;gap:16px;
    padding:16px 0;border-bottom:1px solid var(--line);
  }
  .settings-row .lbl{font-size:14px;flex:1}
  .settings-row .lbl .mini{display:block;color:var(--ink-dim);font-size:12px;margin-top:3px;font-style:italic}
  .switch{
    position:relative;width:46px;height:26px;
    background:var(--bg-2);border:1px solid var(--line-2);border-radius:14px;
    cursor:pointer;transition:background .2s;flex-shrink:0;
  }
  .switch::after{
    content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;
    background:var(--ink-dim);border-radius:50%;transition:.2s;
  }
  .switch.on{background:var(--accent);border-color:var(--accent)}
  .switch.on::after{left:22px;background:#faf6ec}
  .mini-btn{
    padding:8px 14px;border-radius:8px;border:1px solid var(--line-2);
    background:transparent;color:var(--ink);cursor:pointer;
    font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.15em;text-transform:uppercase;
  }
  .mini-btn:active{transform:scale(.97)}
  .select-row{display:flex;gap:6px;padding:0 0 16px;border-bottom:1px solid var(--line);margin-bottom:0}
  .select-row button{
    flex:1;padding:10px;border:1px solid var(--line-2);
    background:transparent;color:var(--ink-dim);border-radius:8px;
    font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.12em;
    text-transform:uppercase;cursor:pointer;
  }
  .select-row button.active{background:var(--accent);color:#faf6ec;border-color:var(--accent);font-weight:600}
  .danger-btn{
    width:100%;margin-top:14px;padding:14px;
    background:transparent;color:#b85450;
    border:1px solid rgba(184,84,80,.3);border-radius:10px;
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;
    text-transform:uppercase;cursor:pointer;
  }
  .info-box{
    background:rgba(122,155,124,.08);border-left:2px solid var(--walk);
    padding:14px 16px;border-radius:0 10px 10px 0;font-size:13px;
    line-height:1.55;color:var(--ink-dim);margin-bottom:12px;
  }
  .info-box b{color:var(--ink)}

  /* ENTRENO ACTIVO */
  .workout-overlay{
    position:fixed;inset:0;z-index:100;
    background:var(--bg);
    display:none;flex-direction:column;
    padding:30px 24px calc(24px + env(safe-area-inset-bottom));
  }
  .workout-overlay.active{display:flex}
  .workout-overlay .w-top{
    display:flex;justify-content:space-between;align-items:center;
  }
  .w-week{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;color:var(--ink-dim);text-transform:uppercase}
  .w-close{
    background:none;border:1px solid var(--line-2);color:var(--ink);
    width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:18px;line-height:1;
  }
  .w-phase{
    font-family:'Fraunces',serif;font-weight:800;font-style:italic;
    font-size:52px;letter-spacing:-.03em;line-height:1;margin-top:22px;
    transition:color .3s;
  }
  .w-phase.walking{color:var(--walk)}
  .w-phase.running{color:var(--run)}
  .w-phase.warmup{color:var(--warmup)}
  .w-phase.cooldown{color:var(--walk)}
  .w-phase.done{color:var(--ok)}
  .w-instruction{font-size:15px;color:var(--ink-dim);margin-top:6px;font-style:italic}
  .w-ring{
    flex:1;display:flex;align-items:center;justify-content:center;
    position:relative;margin:14px 0;
  }
  .w-ring svg{width:100%;max-width:270px;height:auto;transform:rotate(-90deg)}
  .w-ring .ring-track{fill:none;stroke:var(--line);stroke-width:8}
  .w-ring .ring-progress{fill:none;stroke:var(--accent);stroke-width:8;stroke-linecap:round;transition:stroke-dashoffset 1s linear,stroke .3s}
  .w-ring.walking .ring-progress{stroke:var(--walk)}
  .w-ring.running .ring-progress{stroke:var(--run)}
  .w-ring.warmup .ring-progress{stroke:var(--warmup)}
  .w-ring.cooldown .ring-progress{stroke:var(--warmup)}
  .w-ring .time{
    position:absolute;text-align:center;
  }
  .w-ring .time .big{
    font-family:'JetBrains Mono',monospace;font-size:56px;font-weight:500;
    letter-spacing:-.02em;line-height:1;
  }
  .w-ring .time .lbl{
    font-family:'JetBrains Mono',monospace;font-size:10px;
    letter-spacing:.25em;color:var(--ink-dim);text-transform:uppercase;
    margin-top:10px;
  }
  .w-total{
    text-align:center;font-family:'JetBrains Mono',monospace;
    font-size:12px;color:var(--ink-dim);margin-bottom:12px;letter-spacing:.15em;
  }
  .w-total b{color:var(--ink);font-weight:600}
  .w-progress{
    height:3px;background:var(--line);border-radius:2px;overflow:hidden;margin-bottom:20px;
  }
  .w-gps{
    display:grid;grid-template-columns:1fr 1fr;gap:14px;
    background:rgba(122,155,124,.08);border:1px solid var(--line);
    border-radius:12px;padding:12px;margin-bottom:14px;
  }
  .w-gps-item{text-align:center}
  .w-gps-item .val{
    display:block;font-family:'JetBrains Mono',monospace;
    font-size:22px;font-weight:600;color:var(--ok);line-height:1;
  }
  .w-gps-item .lbl{
    display:block;font-family:'JetBrains Mono',monospace;
    font-size:9px;letter-spacing:.22em;color:var(--ink-dim);
    text-transform:uppercase;margin-top:6px;
  }
  .w-map{
    height:180px;border-radius:12px;overflow:hidden;margin-bottom:14px;
    border:1px solid var(--line);background:var(--bg-2);
  }
  #w-map{width:100%;height:100%}
  .route-map{
    height:320px;border-radius:12px;overflow:hidden;
    border:1px solid var(--line);background:var(--bg-2);
  }
  #mr-map{width:100%;height:100%}
  /* Los tiles OSM son algo saturados; desaturamos un pelín para integrarlos con la paleta crema */
  .leaflet-tile{
    filter:saturate(.75) contrast(.95) brightness(1.02);
  }
  /* Esconder el atribución de Leaflet si estorba en el mini-mapa */
  .w-map .leaflet-control-attribution{font-size:8px;opacity:.7}
  .route-map .leaflet-control-attribution{font-size:9px}
  .w-progress-bar{height:100%;background:var(--accent);transition:width .5s linear;width:0%}
  .w-controls{display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:10px}
  .w-controls button{
    padding:16px 10px;border-radius:12px;border:1px solid var(--line-2);
    background:var(--bg-2);color:var(--ink);cursor:pointer;
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;
  }
  .w-controls .primary{
    background:var(--accent);color:#faf6ec;border-color:var(--accent);font-weight:600;
  }
  .w-controls button:active{transform:scale(.97)}

  /* MODAL */
  .modal{
    position:fixed;inset:0;background:rgba(46,46,46,.45);z-index:200;
    display:none;align-items:flex-end;backdrop-filter:blur(4px);
    -webkit-backdrop-filter:blur(4px);
  }
  .modal.active{display:flex}
  .modal-card{
    width:100%;background:var(--bg-2);
    border-radius:22px 22px 0 0;padding:28px 24px calc(28px + env(safe-area-inset-bottom));
    border-top:1px solid var(--line-2);
    animation:slideup .3s ease;
  }
  @keyframes slideup{from{transform:translateY(100%)}to{transform:none}}
  .modal-card h3{font-size:24px;font-weight:800;font-style:italic;margin-bottom:6px}
  .modal-card p{color:var(--ink-dim);font-size:14px;margin-bottom:20px;line-height:1.5}
  .modal-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
  .modal-stats .stat{background:var(--bg);padding:14px;border-radius:10px;text-align:left}
  .modal-stats .stat .val{font-size:18px;text-align:left}
  .modal-stats .stat .lbl{font-size:9px;text-align:left}
