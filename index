<script>
/* =========================================================
   PLAN 12 semanas - 3 sesiones/sem
   Cada sesión: 5' calentamiento + bloque + 5' vuelta a la calma
   Fases: warmup | run | walk | cooldown
========================================================= */
const PLAN = [
  { w:1,  title:"Primer arranque",        sub:"6× (1' correr + 2' andar)",
    block:[ {t:60,p:'run'},{t:120,p:'walk'},{t:60,p:'run'},{t:120,p:'walk'},
            {t:60,p:'run'},{t:120,p:'walk'},{t:60,p:'run'},{t:120,p:'walk'},
            {t:60,p:'run'},{t:120,p:'walk'},{t:60,p:'run'},{t:120,p:'walk'} ],
    tip:"Corre muy despacio. Si no puedes hablar mientras corres, vas demasiado rápido." },

  { w:2,  title:"Más rodaje",              sub:"7× (1' correr + 2' andar)",
    block:[ {t:60,p:'run'},{t:120,p:'walk'},{t:60,p:'run'},{t:120,p:'walk'},
            {t:60,p:'run'},{t:120,p:'walk'},{t:60,p:'run'},{t:120,p:'walk'},
            {t:60,p:'run'},{t:120,p:'walk'},{t:60,p:'run'},{t:120,p:'walk'},
            {t:60,p:'run'},{t:120,p:'walk'} ],
    tip:"Esta semana sumamos una serie más. Mantén el mismo ritmo lento de la semana 1." },

  { w:3,  title:"Estirar el paso",         sub:"6× (1'30\" correr + 2' andar)",
    block:[ {t:90,p:'run'},{t:120,p:'walk'},{t:90,p:'run'},{t:120,p:'walk'},
            {t:90,p:'run'},{t:120,p:'walk'},{t:90,p:'run'},{t:120,p:'walk'},
            {t:90,p:'run'},{t:120,p:'walk'},{t:90,p:'run'},{t:120,p:'walk'} ],
    tip:"Minuto y medio puede parecer eterno al principio. Respira por la nariz y por la boca." },

  { w:4,  title:"Dos minutos",             sub:"5× (2' correr + 2' andar)",
    block:[ {t:120,p:'run'},{t:120,p:'walk'},{t:120,p:'run'},{t:120,p:'walk'},
            {t:120,p:'run'},{t:120,p:'walk'},{t:120,p:'run'},{t:120,p:'walk'},
            {t:120,p:'run'},{t:120,p:'walk'} ],
    tip:"Relación 1:1 corriendo/andando. Empieza a notar cómo tu cuerpo se adapta." },

  { w:5,  title:"Tres minutos",            sub:"4× (3' correr + 2' andar)",
    block:[ {t:180,p:'run'},{t:120,p:'walk'},{t:180,p:'run'},{t:120,p:'walk'},
            {t:180,p:'run'},{t:120,p:'walk'},{t:180,p:'run'},{t:120,p:'walk'} ],
    tip:"Primera vez corriendo 3 minutos seguidos. Cuidado con salir rápido — el ritmo se mantiene suave." },

  { w:6,  title:"Bloques de 5",            sub:"3× (5' correr + 2' andar)",
    block:[ {t:300,p:'run'},{t:120,p:'walk'},{t:300,p:'run'},{t:120,p:'walk'},
            {t:300,p:'run'},{t:120,p:'walk'} ],
    tip:"5 minutos es un umbral psicológico. Si aguantas esto, el resto del plan está al alcance." },

  { w:7,  title:"Series largas",           sub:"2× (8' correr + 2' andar)",
    block:[ {t:480,p:'run'},{t:120,p:'walk'},{t:480,p:'run'},{t:120,p:'walk'} ],
    tip:"Divide mentalmente los 8 minutos en bloques de 2. Cuenta pasos o respiraciones si te ayuda." },

  { w:8,  title:"Diez minutos",            sub:"2× (10' correr + 2' andar)",
    block:[ {t:600,p:'run'},{t:120,p:'walk'},{t:600,p:'run'},{t:120,p:'walk'} ],
    tip:"Ya corres 20 minutos en total. La diferencia con la semana 1 es enorme. Felicítate." },

  { w:9,  title:"Casi continuo",           sub:"12' + 2' andar + 12' correr",
    block:[ {t:720,p:'run'},{t:120,p:'walk'},{t:720,p:'run'} ],
    tip:"Último descanso intermedio del plan. La próxima semana empezamos con carrera continua." },

  { w:10, title:"Carrera continua",        sub:"20' corriendo sin parar",
    block:[ {t:1200,p:'run'} ],
    tip:"Gran salto mental. Ritmo MUY lento — el objetivo es terminar sin parar, no ir rápido." },

  { w:11, title:"Veinticinco",             sub:"25' corriendo sin parar",
    block:[ {t:1500,p:'run'} ],
    tip:"Ya estás a un paso de los 30 minutos. Mantén ritmo conversacional." },

  { w:12, title:"5K",                       sub:"30' corriendo ≈ 5 kilómetros",
    block:[ {t:1800,p:'run'} ],
    tip:"El día ha llegado. No hay prisa, solo llegar. En 30 minutos habrás hecho tu primer 5K." },
];

const WARMUP  = { t:300, p:'warmup' };
const COOLDOWN= { t:300, p:'cooldown' };

/* Construir segmentos completos */
function buildSession(weekIdx){
  const w = PLAN[weekIdx];
  return [ WARMUP, ...w.block, COOLDOWN ];
}

function totalTime(segments){ return segments.reduce((a,s)=>a+s.t,0); }
function runTime(segments){ return segments.filter(s=>s.p==='run').reduce((a,s)=>a+s.t,0); }
function fmtMin(s){ return Math.round(s/60)+"'"; }
function fmtTime(s){
  const m = Math.floor(s/60), sec = s%60;
  return m + ":" + String(sec).padStart(2,'0');
}

/* =========================================================
   ESTADO persistente
========================================================= */
const K = 'c25k_state_v1';
const defaultState = {
  currentWeek: 0,      // 0-11
  sessionsInWeek: 0,   // 0,1,2 -> al llegar a 3 avanza semana
  sessions: [],        // {date, week, session, totalSec, runSec, completed}
  settings: { mode:'voice', duck:true, warn:true, vibe:true, gps:false }
};
let S = loadState();

function loadState(){
  try{
    const raw = localStorage.getItem(K);
    if(!raw) return structuredClone(defaultState);
    const loaded = JSON.parse(raw);
    const merged = { ...structuredClone(defaultState), ...loaded };
    // Migración: si viene un 'voice' boolean antiguo en settings, conviértelo
    merged.settings = { ...defaultState.settings, ...(loaded.settings||{}) };
    if(typeof loaded.settings?.voice === 'boolean' && !loaded.settings.mode){
      merged.settings.mode = loaded.settings.voice ? 'voice' : 'beep';
    }
    if(!['voice','beep','both'].includes(merged.settings.mode)) merged.settings.mode = 'voice';
    return merged;
  }catch(e){ return structuredClone(defaultState); }
}
function saveState(){ localStorage.setItem(K, JSON.stringify(S)); }

/* =========================================================
   AUDIO: voz + pitidos + ducking de música externa
   Nota sobre el ducking:
   - En iOS/Android, Web Speech API (TTS) va por un canal
     distinto al multimedia. Para forzar que Spotify baje el
     volumen mientras hablamos, reproducimos un pitido (u oscilador)
     a través del canal de audio "media" justo antes y durante
     la locución. El sistema operativo aplica "ducking" automático.
========================================================= */
let audioCtx = null;
function getAudioCtx(){
  if(!audioCtx){
    try{ audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    catch(e){ return null; }
  }
  if(audioCtx.state === 'suspended'){ audioCtx.resume().catch(()=>{}); }
  return audioCtx;
}

/* Pitido único. freq Hz, duración ms, volumen 0-1 */
function beep(freq=880, durMs=180, vol=0.6){
  const ctx = getAudioCtx();
  if(!ctx) return;
  const osc = ctx.createOscillator();
  const g = ctx.createGain();
  osc.type = 'sine';
  osc.frequency.value = freq;
  // Envelope suave para no "clicar"
  const t0 = ctx.currentTime;
  g.gain.setValueAtTime(0, t0);
  g.gain.linearRampToValueAtTime(vol, t0+0.015);
  g.gain.linearRampToValueAtTime(vol, t0 + durMs/1000 - 0.03);
  g.gain.linearRampToValueAtTime(0, t0 + durMs/1000);
  osc.connect(g).connect(ctx.destination);
  osc.start(t0);
  osc.stop(t0 + durMs/1000 + 0.01);
}

/* Reproduce N pitidos separados. Claves:
   1 = andar (tono medio-grave, verde)
   2 = correr (tono medio-agudo)
   3 = vuelta a la calma (descendente) */
function beepPattern(kind){
  const ctx = getAudioCtx();
  if(!ctx) return;
  if(kind === 'walk')       { beep(660, 250, 0.55); }
  else if(kind === 'run')   { beep(880, 200, 0.6); setTimeout(()=>beep(880,200,0.6), 280); }
  else if(kind === 'warmup'){ beep(550, 250, 0.55); }
  else if(kind === 'cooldown'){ beep(700,200,0.55); setTimeout(()=>beep(560,200,0.55),260); setTimeout(()=>beep(440,280,0.55),520); }
  else if(kind === 'pre')   { beep(1000, 90, 0.4); setTimeout(()=>beep(1000,90,0.4),140); }
  else if(kind === 'done')  { beep(660,180,0.5); setTimeout(()=>beep(880,180,0.5),200); setTimeout(()=>beep(1100,400,0.5),400); }
}

/* Ducking: tono silencioso continuo mientras la voz habla,
   para que el sistema baje Spotify y lo recupere al acabar */
let duckOsc = null;
let duckGain = null;
function startDuck(){
  if(!S.settings.duck) return;
  const ctx = getAudioCtx();
  if(!ctx) return;
  if(duckOsc) return;
  try{
    duckOsc = ctx.createOscillator();
    duckGain = ctx.createGain();
    duckOsc.frequency.value = 100;     // tono muy bajo
    duckGain.gain.value = 0.001;       // prácticamente inaudible, pero el SO lo cuenta como media
    duckOsc.connect(duckGain).connect(ctx.destination);
    duckOsc.start();
  }catch(e){}
}
function stopDuck(){
  if(duckOsc){
    try{ duckOsc.stop(); duckOsc.disconnect(); duckGain.disconnect(); }catch(e){}
    duckOsc = null; duckGain = null;
  }
}

/* =========================================================
   VOZ (Web Speech API)
========================================================= */
let voicesLoaded = false;
let esVoice = null;
function pickVoice(){
  if(!('speechSynthesis' in window)) return;
  try{
    const voices = speechSynthesis.getVoices();
    if(!voices.length) return;
    esVoice = voices.find(v=>v.lang==='es-ES') ||
              voices.find(v=>v.lang.startsWith('es')) ||
              voices[0];
    voicesLoaded = true;
  }catch(e){}
}
// Inicializar la voz cuando el DOM esté listo y speechSynthesis disponible
if(typeof window !== 'undefined'){
  if('speechSynthesis' in window){
    pickVoice();
    try{ speechSynthesis.onvoiceschanged = pickVoice; }catch(e){}
  }
}

function speakVoice(text){
  if(!('speechSynthesis' in window)) return;
  try{
    speechSynthesis.cancel();
    // Activa ducking ANTES de empezar a hablar
    startDuck();
    const u = new SpeechSynthesisUtterance(text);
    if(esVoice) u.voice = esVoice;
    u.lang = 'es-ES';
    u.rate = 1.0;
    u.pitch = 1.0;
    u.volume = 1.0;
    u.onend = ()=> setTimeout(stopDuck, 400);  // pequeño margen tras la locución
    u.onerror = ()=> stopDuck();
    speechSynthesis.speak(u);
  }catch(e){ stopDuck(); console.warn(e); }
}

/* Notifica cambio a una fase. Respeta modo: voz / beep / ambos */
function notifyPhase(phaseKind, text){
  const mode = S.settings.mode || 'voice';
  if(mode === 'beep'){
    beepPattern(phaseKind);
  } else if(mode === 'both'){
    beepPattern(phaseKind);
    setTimeout(()=> speakVoice(text), 600);
  } else {
    speakVoice(text);
  }
}

/* Aviso previo (10s antes del cambio) */
function notifyPre(text){
  const mode = S.settings.mode || 'voice';
  if(mode === 'beep'){
    beepPattern('pre');
  } else if(mode === 'both'){
    beepPattern('pre');
    setTimeout(()=> speakVoice(text), 400);
  } else {
    speakVoice(text);
  }
}

function testVoice(){
  const mode = S.settings.mode || 'voice';
  if(mode === 'beep'){
    // Demo: andar, correr, vuelta a la calma
    beepPattern('walk');
    setTimeout(()=>beepPattern('run'), 900);
    setTimeout(()=>beepPattern('cooldown'), 2100);
  } else {
    speakVoice("Prueba de voz. Ahora a correr. Caminando. Vuelta a la calma.");
  }
}

function vibrate(pattern){
  if(!S.settings.vibe) return;
  if('vibrate' in navigator){ try{ navigator.vibrate(pattern); }catch(e){} }
}

